<mvc:View
    controllerName="zoa.zoarequestui.controller.Shell"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    displayBlock="true"
    height="100%">

    <Page showHeader="false" enableScrolling="true" class="zoaPageContainer">

        <customHeader>
            <f:ShellBar
                id="shellBar"
                title="One Answer"
                secondTitle="{shellModel>/userSubtitle}"
                showNotifications="true"
                notificationsNumber="{shellModel>/alertCount}"
                notificationsPressed=".onNotificationsPress"
                class="zoaShellBar">
                <f:additionalContent>
                    <Button text="Authority App" icon="sap-icon://customer-and-supplier" type="Transparent" press=".onSwitchToAuthority" tooltip="Open Teacher / HOD Approval Portal"/>
                    <Button text="Logout" icon="sap-icon://log-out" type="Transparent" press=".onLogoutPress" tooltip="Logout to Switch Role"/>
                </f:additionalContent>
            </f:ShellBar>
        </customHeader>

        <content>
            <IconTabBar
                id="mainTabBar"
                expanded="true"
                stretchContentHeight="false"
                class="zoaTabBar">
                <items>

                    <!-- ═══════════════════════════════
                         EVENTS & HOLIDAYS (CONFIRMED)
                    ═══════════════════════════════ -->
                    <IconTabFilter
                        id="tabEvents"
                        key="events"
                        icon="sap-icon://calendar"
                        text="Events">
                        <content>
                            <VBox class="zoaContentContainer">
                                <HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="zoaHeaderToolbar">
                                    <Title text="Confirmed Events" level="H3" class="zoaSectionTitle"/>
                                    <HBox alignItems="Center">
                                        <SegmentedButton id="eventsTopicFilter" selectedKey="ALL" selectionChange=".onFilterEventsByTopic" class="zoaEventsSegBtn sapUiTinyMarginEnd">
                                            <items>
                                                <SegmentedButtonItem key="ALL" text="All"/>
                                                <SegmentedButtonItem key="EVENT" text="Events"/>
                                                <SegmentedButtonItem key="TRIP" text="Trips"/>
                                                <SegmentedButtonItem key="HOLIDAY" text="Holidays"/>
                                            </items>
                                        </SegmentedButton>
                                        <Button text="+ New Request" type="Emphasized" press=".onOpenCreateDialog" visible="{= !${shellModel>/isStudent} }" class="zoaPrimaryButton sapUiTinyMarginEnd"/>
                                        <Button icon="sap-icon://refresh" press=".onRefreshPress" tooltip="Refresh" class="zoaSecondaryBtn"/>
                                    </HBox>
                                </HBox>
                                <List
                                    id="eventsList"
                                    items="{
                                        path: '/Request',
                                        filters: [{ path: 'Status', operator: 'EQ', value1: 'C' }],
                                        sorter: [{ path: 'LastChangedAt', descending: true }, { path: 'EventDate', descending: true }]
                                    }"
                                    noDataText="{i18n>eventsEmptyTitle}"
                                    busyIndicatorDelay="0"
                                    showSeparators="None">
                                    <CustomListItem class="zoaCardItem">
                                        <customData>
                                            <core:CustomData key="status" value="confirmed" writeToDom="true"/>
                                        </customData>
                                        <HBox alignItems="Center" justifyContent="SpaceBetween" width="100%">
                                            <HBox alignItems="Center">
                                                <!-- Calendar Date Tile -->
                                                <VBox class="zoaDateBox" justifyContent="Center" alignItems="Center">
                                                    <Text text="{path: 'EventDate', formatter: '.formatDateMonth'}" class="zoaDateMonth"/>
                                                    <Text text="{path: 'EventDate', formatter: '.formatDateDay'}" class="zoaDateDay"/>
                                                </VBox>
                                                <!-- Event Details -->
                                                <VBox>
                                                    <HBox alignItems="Center">
                                                        <ObjectStatus
                                                            text="{Topic}"
                                                            state="{= ${Topic} === 'HOLIDAY' ? 'Information' : (${Topic} === 'EVENT' ? 'Indication06' : 'Warning') }"
                                                            class="zoaMiniTopicTag sapUiTinyMarginEnd"/>
                                                        <Title text="{Title}" level="H5"/>
                                                    </HBox>
                                                    <Text
                                                        text="{parts: [{path: 'AuthorityRole', targetType: 'any'}, {path: 'DecisionReason', targetType: 'any'}], formatter: '.formatEventMeta'}"
                                                        visible="{= !!${path: 'AuthorityRole', targetType: 'any'} || !!${path: 'DecisionReason', targetType: 'any'} }"
                                                        class="zoaCardMeta"/>
                                                </VBox>
                                            </HBox>
                                            <!-- Status Pill -->
                                            <HBox alignItems="Center">
                                                <ObjectStatus
                                                    text="Confirmed"
                                                    state="Success"
                                                    icon="sap-icon://accept"
                                                    inverted="true"/>
                                            </HBox>
                                        </HBox>
                                    </CustomListItem>
                                </List>
                            </VBox>
                        </content>
                    </IconTabFilter>

                    <!-- ═══════════════════════════════
                         REQUESTS (LIVE SAP TABLE)
                    ═══════════════════════════════ -->
                    <IconTabFilter
                        id="tabRequests"
                        key="requests"
                        icon="sap-icon://request"
                        text="Requests">
                        <content>
                            <VBox class="zoaContentContainer">
                                <!-- Top Header Row -->
                                <HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="zoaHeaderToolbar">
                                    <Title text="Requests" level="H3" class="zoaSectionTitle"/>
                                    <HBox alignItems="Center">
                                        <Button text="Classic Table" icon="sap-icon://table-view" press=".onOpenClassicTable" visible="{= !${shellModel>/isStudent} }" tooltip="Open Fiori Elements Table Backup" class="zoaSecondaryBtn sapUiTinyMarginEnd"/>
                                        <Button text="+ New Request" type="Emphasized" press=".onOpenCreateDialog" class="zoaPrimaryButton sapUiTinyMarginEnd"/>
                                        <Button icon="sap-icon://refresh" press=".onRefreshPress" tooltip="Refresh" class="zoaSecondaryBtn"/>
                                    </HBox>
                                </HBox>

                                <!-- Status Section Tabs with Live Counts -->
                                <HBox class="zoaStatusFilterBar" alignItems="Center" wrap="Wrap">
                                    <Button
                                        id="btnStatusAll"
                                        text="All Requests ({shellModel>/counts/all})"
                                        press=".onSelectStatusFilter('ALL')"
                                        class="zoaStatusTabBtn zoaStatusTabActive"/>
                                    <Button
                                        id="btnStatusPending"
                                        text="Pending Review ({shellModel>/counts/pending})"
                                        press=".onSelectStatusFilter('P')"
                                        class="zoaStatusTabBtn"/>
                                    <Button
                                        id="btnStatusApproved"
                                        text="Approved ({shellModel>/counts/approved})"
                                        press=".onSelectStatusFilter('C')"
                                        class="zoaStatusTabBtn"/>
                                    <Button
                                        id="btnStatusDeclined"
                                        text="Declined ({shellModel>/counts/declined})"
                                        press=".onSelectStatusFilter('N')"
                                        class="zoaStatusTabBtn"/>
                                </HBox>

                                <!-- Type Filter Pills + Search Box -->
                                <HBox class="zoaTypeSearchBar" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
                                    <HBox alignItems="Center" wrap="Wrap">
                                        <Text text="TYPE:" class="zoaTypeLabel"/>
                                        <Button
                                            id="btnTypeAll"
                                            text="All Types"
                                            press=".onSelectTypeFilter('ALL')"
                                            class="zoaTypePillBtn zoaTypePillActive"/>
                                        <Button
                                            id="btnTypeTrip"
                                            text="Trip"
                                            press=".onSelectTypeFilter('TRIP')"
                                            class="zoaTypePillBtn"/>
                                        <Button
                                            id="btnTypeEvent"
                                            text="Event"
                                            press=".onSelectTypeFilter('EVENT')"
                                            class="zoaTypePillBtn"/>
                                        <Button
                                            id="btnTypeHoliday"
                                            text="Holiday"
                                            press=".onSelectTypeFilter('HOLIDAY')"
                                            class="zoaTypePillBtn"/>
                                    </HBox>
                                    <SearchField
                                        id="reqSearchField"
                                        width="240px"
                                        placeholder="Search ID or title..."
                                        liveChange=".onSearchRequests"
                                        search=".onSearchRequests"
                                        class="zoaSearchField"/>
                                </HBox>

                                <List
                                    id="requestsList"
                                    items="{
                                        path: '/Request',
                                        sorter: [{ path: 'CreatedAt', descending: true }, { path: 'LastChangedAt', descending: true }, { path: 'EventDate', descending: true }]
                                    }"
                                    noDataText="No requests found"
                                    busyIndicatorDelay="0"
                                    updateFinished=".onRequestsLoaded"
                                    showSeparators="None">
                                    <CustomListItem class="zoaCardItem">
                                        <customData>
                                            <core:CustomData
                                                key="status"
                                                value="{parts: [{path: 'Status', targetType: 'any'}, {path: 'StatusText', targetType: 'any'}], formatter: '.formatStatusCssKey'}"
                                                writeToDom="true"/>
                                        </customData>
                                        <HBox alignItems="Center" justifyContent="SpaceBetween" width="100%" wrap="Wrap">
                                            <HBox alignItems="Center">
                                                <core:Icon
                                                    src="{= ${Topic} === 'HOLIDAY' ? 'sap-icon://flight' : (${Topic} === 'EVENT' ? 'sap-icon://theater' : 'sap-icon://map') }"
                                                    size="1.45rem"
                                                    color="{= ${Topic} === 'HOLIDAY' ? '#0070F2' : (${Topic} === 'EVENT' ? '#7E22CE' : '#B45309') }"
                                                    class="sapUiSmallMarginEnd sapUiTinyMarginBegin"/>
                                                <VBox>
                                                    <HBox alignItems="Center">
                                                        <Title text="{Title}" level="H5" class="sapUiTinyMarginEnd"/>
                                                        <ObjectStatus
                                                            text="{Topic}"
                                                            state="{= ${Topic} === 'HOLIDAY' ? 'Information' : (${Topic} === 'EVENT' ? 'Indication06' : 'Warning') }"
                                                            class="zoaMiniTopicTag sapUiTinyMarginEnd"/>
                                                    </HBox>
                                                    <Text text="{parts: [{path: 'EventDate', targetType: 'any'}, {path: 'Topic', targetType: 'any'}, {path: 'AuthorityRole', targetType: 'any'}, {path: 'DecideBy', targetType: 'any'}, {path: 'Status', targetType: 'any'}, {path: 'StatusText', targetType: 'any'}, {path: 'CreatedBy', targetType: 'any'}, {path: 'Description', targetType: 'any'}, {path: 'shellModel>/isStudent', targetType: 'any'}], formatter: '.formatCardMeta'}" class="zoaCardMeta"/>
                                                    <Text text="{parts: [{path: 'Description', targetType: 'any'}, {path: 'DecisionReason', targetType: 'any'}], formatter: '.formatSubInfo'}" visible="{= !!${path: 'Description', targetType: 'any'} || !!${path: 'DecisionReason', targetType: 'any'} }" class="zoaCardSubText"/>
                                                </VBox>
                                            </HBox>
                                            <HBox alignItems="Center">
                                                <ObjectStatus
                                                    text="{parts: ['Status', 'StatusText'], formatter: '.formatStatusText'}"
                                                    state="{parts: ['Status', 'StatusText'], formatter: '.formatStatusState'}"
                                                    icon="{parts: ['Status', 'StatusText'], formatter: '.formatStatusIcon'}"
                                                    inverted="true"
                                                    class="sapUiSmallMarginEnd"/>
                                                <Button
                                                    text="Happening"
                                                    icon="sap-icon://accept"
                                                    press=".onConfirmRequestPress"
                                                    visible="{parts: [{path: 'shellModel>/isStudent', targetType: 'any'}, {path: 'shellModel>/role', targetType: 'any'}, {path: 'Status', targetType: 'any'}, {path: 'StatusText', targetType: 'any'}, {path: 'Topic', targetType: 'any'}, {path: 'AuthorityRole', targetType: 'any'}, {path: '__OperationControl/confirmRequest', targetType: 'any'}], formatter: '.formatCanDecide'}"
                                                    class="zoaHappeningBtn sapUiTinyMarginEnd"/>
                                                <Button
                                                    text="Not happening"
                                                    icon="sap-icon://decline"
                                                    press=".onRejectRequestPress"
                                                    visible="{parts: [{path: 'shellModel>/isStudent', targetType: 'any'}, {path: 'shellModel>/role', targetType: 'any'}, {path: 'Status', targetType: 'any'}, {path: 'StatusText', targetType: 'any'}, {path: 'Topic', targetType: 'any'}, {path: 'AuthorityRole', targetType: 'any'}, {path: '__OperationControl/rejectRequest', targetType: 'any'}], formatter: '.formatCanDecide'}"
                                                    class="zoaNotHappeningBtn sapUiTinyMarginEnd"/>
                                                <Button
                                                    icon="sap-icon://delete"
                                                    type="Transparent"
                                                    tooltip="Delete Request"
                                                    press=".onDeleteRequestPress"
                                                    visible="{parts: [{path: 'Status', targetType: 'any'}, {path: 'StatusText', targetType: 'any'}, {path: '__EntityControl/Deletable', targetType: 'any'}], formatter: '.formatCanDelete'}"
                                                    class="zoaDeleteButton"/>
                                            </HBox>
                                        </HBox>
                                    </CustomListItem>
                                </List>
                            </VBox>
                        </content>
                    </IconTabFilter>

                    <!-- ═══════════════════════════════
                         ALERTS
                    ═══════════════════════════════ -->
                    <IconTabFilter
                        id="tabAlerts"
                        key="alerts"
                        icon="sap-icon://bell"
                        count="{shellModel>/alertCount}"
                        text="Alerts">
                        <content>
                            <VBox class="zoaContentContainer">
                                <HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="zoaHeaderToolbar">
                                    <Title text="Alerts" level="H3" class="zoaSectionTitle"/>
                                    <HBox alignItems="Center">
                                        <Button icon="sap-icon://refresh" press=".onRefreshPress" tooltip="Refresh" class="zoaSecondaryBtn sapUiTinyMarginEnd"/>
                                        <Text text="{shellModel>/alertCount} Alerts" visible="{= !!${shellModel>/alertCount} }" class="zoaAlertCountPill sapUiTinyMarginEnd"/>
                                        <Button text="Dismiss All" icon="sap-icon://accept" press=".onDismissAllAlerts" visible="{= !!${shellModel>/alertCount} }" class="zoaSecondaryBtn"/>
                                    </HBox>
                                </HBox>
                                <List
                                    id="alertsList"
                                    items="{
                                        path: '/Alert',
                                        sorter: { path: 'AlertDate', descending: true }
                                    }"
                                    noDataText="{i18n>alertsEmptyTitle}"
                                    busyIndicatorDelay="0"
                                    updateFinished=".onAlertsLoaded"
                                    showSeparators="None">
                                    <CustomListItem class="zoaCardItem zoaAlertCard">
                                        <HBox alignItems="Center" justifyContent="SpaceBetween" width="100%">
                                            <HBox alignItems="Center">
                                                <core:Icon
                                                    src="sap-icon://alert"
                                                    size="1.5rem"
                                                    color="#D97706"
                                                    class="sapUiSmallMarginEnd sapUiTinyMarginBegin"/>
                                                <VBox>
                                                    <Title text="{AlertText}" level="H5"/>
                                                    <Text text="System Alert · {path: 'AlertDate', type: 'sap.ui.model.odata.type.Date'}" class="zoaCardMeta"/>
                                                </VBox>
                                            </HBox>
                                            <Button
                                                icon="sap-icon://decline"
                                                type="Transparent"
                                                press=".onAlertClose"
                                                tooltip="Dismiss"/>
                                        </HBox>
                                    </CustomListItem>
                                </List>
                            </VBox>
                        </content>
                    </IconTabFilter>

                    <!-- ═══════════════════════════════
                         ASK AI (CHAT INTERFACE)
                    ═══════════════════════════════ -->
                    <IconTabFilter
                        key="ask"
                        icon="sap-icon://discussion"
                        text="Ask">
                        <content>
                            <VBox class="zoaContentContainer zoaChatContainer">
                                <!-- Suggestion Chips -->
                                <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                                    <Button text="Upcoming holidays?" type="Transparent" press=".onChipPress" class="zoaChipButton"/>
                                    <Button text="Annual function date &amp; status?" type="Transparent" press=".onChipPress" class="zoaChipButton"/>
                                    <Button text="Minimum attendance rule?" type="Transparent" press=".onChipPress" class="zoaChipButton"/>
                                    <Button text="Status of Class Trip?" type="Transparent" press=".onChipPress" class="zoaChipButton"/>
                                    <Button text="Clear Chat" icon="sap-icon://clear-all" type="Transparent" press=".onClearChat" class="zoaChipButton"/>
                                </HBox>

                                <!-- Chat Feed -->
                                <List
                                    id="chatList"
                                    items="{chat>/messages}"
                                    showNoData="false"
                                    showSeparators="None"
                                    class="sapUiTinyMarginBottom">
                                    <CustomListItem class="zoaChatMessageItem">
                                        <!-- User Message Bubble (Right-aligned, fits content) -->
                                        <HBox visible="{= ${chat>sender} === 'You' }" justifyContent="End" width="100%">
                                            <VBox class="zoaUserBubble">
                                                <Text text="{chat>text}" class="zoaUserBubbleText"/>
                                                <Text text="{chat>time}" class="zoaUserTime"/>
                                            </VBox>
                                        </HBox>
                                        <!-- AI Assistant Message Bubble (Left-aligned, clean card) -->
                                        <HBox visible="{= ${chat>sender} !== 'You' }" justifyContent="Start" width="100%">
                                            <VBox class="zoaBotBubble">
                                                <HBox class="zoaBotHeader" alignItems="Center">
                                                    <core:Icon src="sap-icon://da" size="1rem" color="#0070F2"/>
                                                    <Text text="One Answer AI" class="zoaBotName"/>
                                                    <Text text="· {chat>time}" class="zoaBotTime"/>
                                                </HBox>
                                                <FormattedText htmlText="{path: 'chat>text', formatter: '.formatAiResponse'}" class="zoaBotBubbleText"/>
                                            </VBox>
                                        </HBox>
                                    </CustomListItem>
                                </List>

                                <!-- Busy Indicator -->
                                <FlexBox justifyContent="Center" visible="{chat>/busy}" class="sapUiSmallMargin">
                                    <BusyIndicator text="Checking..."/>
                                </FlexBox>

                                <!-- Input Bar -->
                                <HBox alignItems="Center" class="zoaInputBar sapUiSmallMarginTop" width="100%">
                                    <Input
                                        id="askInput"
                                        placeholder="Type your question about holidays, events, or authority decisions..."
                                        submit=".onAskSend"
                                        enabled="{= !${chat>/busy} }"
                                        class="zoaChatInput">
                                        <layoutData>
                                            <FlexItemData growFactor="1"/>
                                        </layoutData>
                                    </Input>
                                    <Button
                                        icon="sap-icon://paper-plane"
                                        press=".onAskSend"
                                        enabled="{= !${chat>/busy} }"
                                        tooltip="Send Message"
                                        class="zoaSendButton sapUiTinyMarginBegin"/>
                                </HBox>
                            </VBox>
                        </content>
                    </IconTabFilter>

                </items>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>
