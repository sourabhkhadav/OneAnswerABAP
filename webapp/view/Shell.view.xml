<mvc:View
    controllerName="zoa.zoarequestui.controller.Shell"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    displayBlock="true"
    height="100%">

    <Page showHeader="false" enableScrolling="true" class="zoaPageContainer">

        <customHeader>
            <f:ShellBar
                id="shellBar"
                title="{i18n>shellTitle}"
                primaryTitle="{i18n>shellTitle}"
                showNotifications="true"
                notificationsNumber="{shellModel>/alertCount}"
                notificationsPress=".onNotificationsPress"
                class="zoaShellBar"/>
        </customHeader>

        <content>
            <IconTabBar
                id="mainTabBar"
                expanded="true"
                stretchContentHeight="false"
                class="zoaTabBar">
                <items>

                    <!-- ═══════════════════════════════
                         EVENTS & HOLIDAYS (CONFIRMED)
                    ═══════════════════════════════ -->
                    <IconTabFilter
                        key="events"
                        icon="sap-icon://calendar"
                        text="{i18n>tabEvents}">
                        <content>
                            <VBox class="zoaContentContainer">
                                <Toolbar class="zoaHeaderToolbar">
                                    <Title text="Confirmed Events &amp; Holidays" level="H3" class="zoaSectionTitle"/>
                                    <ToolbarSpacer/>
                                    <Button icon="sap-icon://refresh" type="Transparent" press=".onRefreshPress" tooltip="Refresh Events from SAP" class="zoaRefreshButton"/>
                                </Toolbar>
                                <List
                                    id="eventsList"
                                    items="{
                                        path: '/Request',
                                        filters: [{ path: 'Status', operator: 'EQ', value1: 'C' }],
                                        sorter: { path: 'EventDate', descending: false }
                                    }"
                                    noDataText="{i18n>eventsEmptyTitle}"
                                    busyIndicatorDelay="0"
                                    showSeparators="None">
                                    <CustomListItem class="zoaCardItem">
                                        <HBox alignItems="Center" justifyContent="SpaceBetween" width="100%">
                                            <HBox alignItems="Center" class="sapUiTinyMargin">
                                                <!-- Calendar Date Tile -->
                                                <VBox class="zoaDateBox" justifyContent="Center" alignItems="Center">
                                                    <Text text="{path: 'EventDate', formatter: '.formatDateMonth'}" class="zoaDateMonth"/>
                                                    <Text text="{path: 'EventDate', formatter: '.formatDateDay'}" class="zoaDateDay"/>
                                                </VBox>
                                                <!-- Event Details -->
                                                <VBox>
                                                    <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                                        <Text text="{Topic}" class="zoaTopicPill zoaTopicHoliday sapUiTinyMarginEnd"/>
                                                        <Title text="{Title}" level="H4"/>
                                                    </HBox>
                                                    <HBox alignItems="Center" visible="{= !!${DecisionReason} }">
                                                        <core:Icon src="sap-icon://comment" size="0.85rem" color="#64748B" class="sapUiTinyMarginEnd"/>
                                                        <Text text="Reason: {DecisionReason}" class="sapUiTinyMarginBottom"/>
                                                    </HBox>
                                                    <Text text="Approved by {AuthorityRole}" visible="{= !!${AuthorityRole} }"/>
                                                </VBox>
                                            </HBox>
                                            <!-- Status Pill -->
                                            <HBox alignItems="Center">
                                                <ObjectStatus
                                                    text="Confirmed"
                                                    state="Success"
                                                    icon="sap-icon://accept"
                                                    inverted="true"
                                                    class="sapUiSmallMarginEnd"/>
                                            </HBox>
                                        </HBox>
                                    </CustomListItem>
                                </List>
                            </VBox>
                        </content>
                    </IconTabFilter>

                    <!-- ═══════════════════════════════
                         MY REQUESTS (LIVE SAP TABLE)
                    ═══════════════════════════════ -->
                    <IconTabFilter
                        id="tabRequests"
                        key="requests"
                        icon="sap-icon://request"
                        text="Requests">
                        <content>
                            <VBox class="zoaContentContainer">
                                <Toolbar class="zoaHeaderToolbar">
                                    <Title text="SAP Requests (Live Table ZOA_OA_REQUEST)" level="H3" class="zoaSectionTitle"/>
                                    <ToolbarSpacer/>
                                    <Button text="New Request" icon="sap-icon://add" type="Emphasized" press=".onOpenCreateDialog" class="zoaPrimaryButton sapUiTinyMarginEnd"/>
                                    <Button icon="sap-icon://refresh" type="Transparent" press=".onRefreshPress" tooltip="Refresh from SAP" class="zoaRefreshButton"/>
                                </Toolbar>
                                <List
                                    id="requestsList"
                                    items="{
                                        path: '/Request',
                                        sorter: { path: 'EventDate', descending: false }
                                    }"
                                    noDataText="No requests found in SAP database"
                                    busyIndicatorDelay="0"
                                    showSeparators="None">
                                    <CustomListItem class="zoaCardItem">
                                        <HBox alignItems="Center" justifyContent="SpaceBetween" width="100%">
                                            <HBox alignItems="Center">
                                                <core:Icon
                                                    src="{= ${Topic} === 'HOLIDAY' ? 'sap-icon://flight' : (${Topic} === 'EVENT' ? 'sap-icon://theater' : 'sap-icon://map') }"
                                                    size="1.8rem"
                                                    color="{= ${Topic} === 'HOLIDAY' ? '#0070F2' : (${Topic} === 'EVENT' ? '#7E22CE' : '#B45309') }"
                                                    class="sapUiSmallMarginEnd sapUiTinyMarginBegin"/>
                                                <VBox>
                                                    <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                                        <Title text="{Title}" level="H4" class="sapUiTinyMarginEnd"/>
                                                        <Text text="{Topic}" class="zoaTopicPill sapUiTinyMarginEnd"/>
                                                    </HBox>
                                                    <Label text="Event Date: {path: 'EventDate', type: 'sap.ui.model.odata.type.Date'} · Authority: {AuthorityRole}" design="Standard"/>
                                                    <Text text="{Description}" visible="{= !!${Description} }" class="sapUiTinyMarginTop"/>
                                                    <Text text="Decision: {DecisionReason}" visible="{= !!${DecisionReason} }" class="sapUiTinyMarginTop"/>
                                                </VBox>
                                            </HBox>
                                            <HBox alignItems="Center">
                                                <ObjectStatus
                                                    text="{StatusText}"
                                                    state="{= ${Status} === 'C' ? 'Success' : (${Status} === 'N' ? 'Error' : 'Warning') }"
                                                    icon="{= ${Status} === 'C' ? 'sap-icon://accept' : (${Status} === 'N' ? 'sap-icon://decline' : 'sap-icon://pending') }"
                                                    inverted="true"
                                                    class="sapUiSmallMarginEnd"/>
                                                <Button
                                                    icon="sap-icon://delete"
                                                    type="Transparent"
                                                    tooltip="Delete Request"
                                                    press=".onDeleteRequestPress"
                                                    class="zoaDeleteButton"/>
                                            </HBox>
                                        </HBox>
                                    </CustomListItem>
                                </List>
                            </VBox>
                        </content>
                    </IconTabFilter>

                    <!-- ═══════════════════════════════
                         ALERTS
                    ═══════════════════════════════ -->
                    <IconTabFilter
                        id="tabAlerts"
                        key="alerts"
                        icon="sap-icon://bell"
                        text="{i18n>tabAlerts}">
                        <content>
                            <VBox class="zoaContentContainer">
                                <Toolbar class="zoaHeaderToolbar">
                                    <Title text="{i18n>alertsTitle}" level="H3" class="zoaSectionTitle"/>
                                    <ToolbarSpacer/>
                                    <Button icon="sap-icon://refresh" type="Transparent" press=".onRefreshPress" tooltip="Refresh Alerts from SAP" class="zoaRefreshButton"/>
                                    <ObjectStatus
                                        text="{shellModel>/alertCount} Alerts"
                                        state="Warning"
                                        icon="sap-icon://bell"
                                        visible="{= !!${shellModel>/alertCount} }"/>
                                </Toolbar>
                                <List
                                    id="alertsList"
                                    items="{
                                        path: '/Alert',
                                        sorter: { path: 'AlertDate', descending: true }
                                    }"
                                    noDataText="{i18n>alertsEmptyTitle}"
                                    busyIndicatorDelay="0"
                                    updateFinished=".onAlertsLoaded"
                                    showSeparators="None">
                                    <CustomListItem class="zoaCardItem">
                                        <HBox alignItems="Center" justifyContent="SpaceBetween" width="100%">
                                            <HBox alignItems="Center">
                                                <core:Icon
                                                    src="sap-icon://alert"
                                                    size="1.5rem"
                                                    color="#D97706"
                                                    class="sapUiSmallMarginEnd sapUiTinyMarginBegin"/>
                                                <VBox>
                                                    <Text text="{AlertText}" class="sapUiTinyMarginBottom" design="Bold"/>
                                                    <Text text="System Alert · {path: 'AlertDate', type: 'sap.ui.model.odata.type.Date'}"/>
                                                </VBox>
                                            </HBox>
                                            <Button
                                                icon="sap-icon://decline"
                                                type="Transparent"
                                                press=".onAlertClose"
                                                tooltip="Dismiss"/>
                                        </HBox>
                                    </CustomListItem>
                                </List>
                            </VBox>
                        </content>
                    </IconTabFilter>

                    <!-- ═══════════════════════════════
                         ASK AI (CHAT INTERFACE)
                    ═══════════════════════════════ -->
                    <IconTabFilter
                        key="ask"
                        icon="sap-icon://discussion"
                        text="{i18n>tabAsk}">
                        <content>
                            <VBox class="zoaContentContainer zoaChatContainer">
                                <!-- Suggestion Chips -->
                                <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                                    <Button text="Upcoming holidays?" type="Transparent" press=".onChipPress" class="zoaChipButton"/>
                                    <Button text="Annual function date &amp; status?" type="Transparent" press=".onChipPress" class="zoaChipButton"/>
                                    <Button text="Minimum attendance rule?" type="Transparent" press=".onChipPress" class="zoaChipButton"/>
                                    <Button text="Status of Class Trip?" type="Transparent" press=".onChipPress" class="zoaChipButton"/>
                                    <Button text="Clear Chat" icon="sap-icon://clear-all" type="Transparent" press=".onClearChat" class="zoaChipButton"/>
                                </HBox>

                                <!-- Chat Feed -->
                                <List
                                    id="chatList"
                                    items="{chat>/messages}"
                                    showNoData="false"
                                    showSeparators="None"
                                    class="sapUiTinyMarginBottom">
                                    <CustomListItem class="zoaChatMessageItem">
                                        <!-- User Message Bubble (Right-aligned, fits content) -->
                                        <HBox visible="{= ${chat>sender} === 'You' }" justifyContent="End" width="100%">
                                            <VBox class="zoaUserBubble">
                                                <Text text="{chat>text}" class="zoaUserBubbleText"/>
                                                <Text text="{chat>time}" class="zoaUserTime"/>
                                            </VBox>
                                        </HBox>
                                        <!-- AI Assistant Message Bubble (Left-aligned, clean card) -->
                                        <HBox visible="{= ${chat>sender} !== 'You' }" justifyContent="Start" width="100%">
                                            <VBox class="zoaBotBubble">
                                                <HBox class="zoaBotHeader" alignItems="Center">
                                                    <core:Icon src="sap-icon://da" size="1rem" color="#0070F2"/>
                                                    <Text text="One Answer AI" class="zoaBotName"/>
                                                    <Text text="· {chat>time}" class="zoaBotTime"/>
                                                </HBox>
                                                <FormattedText htmlText="{path: 'chat>text', formatter: '.formatAiResponse'}" class="zoaBotBubbleText"/>
                                            </VBox>
                                        </HBox>
                                    </CustomListItem>
                                </List>

                                <!-- Busy Indicator -->
                                <FlexBox justifyContent="Center" visible="{chat>/busy}" class="sapUiMediumMargin">
                                    <BusyIndicator text="One Answer AI is checking live SAP database..."/>
                                </FlexBox>

                                <!-- Input Bar -->
                                <HBox alignItems="Center" class="zoaInputBar sapUiSmallMarginTop" width="100%">
                                    <Input
                                        id="askInput"
                                        placeholder="Type your question about holidays, events, or authority decisions..."
                                        submit=".onAskSend"
                                        enabled="{= !${chat>/busy} }"
                                        class="zoaChatInput">
                                        <layoutData>
                                            <FlexItemData growFactor="1"/>
                                        </layoutData>
                                    </Input>
                                    <Button
                                        icon="sap-icon://paper-plane"
                                        press=".onAskSend"
                                        enabled="{= !${chat>/busy} }"
                                        tooltip="Send Message"
                                        class="zoaSendButton sapUiTinyMarginBegin"/>
                                </HBox>
                            </VBox>
                        </content>
                    </IconTabFilter>

                </items>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>
