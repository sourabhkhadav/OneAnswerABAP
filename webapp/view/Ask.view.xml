<mvc:View
    controllerName="zoa.zoarequestui.controller.Ask"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true">

    <VBox
        height="100%"
        alignItems="Center"
        justifyContent="Center">
        <IllustratedMessage
            illustrationType="sapIllus-NoData"
            title="{i18n>askEmptyTitle}"
            description="{i18n>askEmptyDesc}"/>
    </VBox>
</mvc:View>
